# Copia este archivo como .env (ignorado por git) y rellena cada valor.
# Lo usa: docker compose up -d --build

# ── Base de datos ───────────────────────────────────────────────────────────────
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Seguridad (servicio de seguridad y API gateway) ─────────────────────────────
# Pepper de los codigos de recuperacion: openssl rand -hex 32
SECURITY_RESET_PEPPER=
# Origen publico de la web (CORS, lo responde el gateway); con nginx de mismo origen basta
# http://localhost
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost
# Dueño de ./keys (el servicio de seguridad corre como 10001 en la imagen y lee private.pem; el
# backend y el gateway solo reciben public.pem). Si las claves las genera
# prepare.sh con tu usuario, pon aqui tu uid/gid con:  id -u  /  id -g
BACKEND_UID=10001
BACKEND_GID=10001

# ── Comunicacion entre servicios ────────────────────────────────────────────────
# RabbitMQ (eventos de cuenta y pedidos de correo). Cualquier valor aleatorio: openssl rand -hex 24
# El usuario se crea al iniciar el volumen por primera vez: cambiarlo despues exige hacerlo
# tambien dentro de RabbitMQ (rabbitmqctl change_password).
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=
# Token de las llamadas /internal entre los servicios (seguridad, dispositivos, mediciones, hogares,
# notificaciones y backend): openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Servicio de hogares ─────────────────────────────────────────────────────────
# Relay del outbox (home.deleted) y consumidor de account.deleted del servicio de hogares: el
# servicio de hogares es el unico que publica home.deleted y limpia las cuentas borradas. Encendidos
# por defecto; en false solo para volver atras a un backend que aun tenga su modulo de hogares (el
# que lo hacia antes): con los dos encendidos cada mensaje se procesaria dos veces.
# HOME_OUTBOX_RELAY_ENABLED=true
# ACCOUNT_DELETED_CONSUMER_ENABLED=true

# ── Servicio de notificaciones ──────────────────────────────────────────────────
# Consumidores del servicio de notificaciones (eventos de cuenta y codigos de correo; alertas y
# recomendaciones) y relay del outbox del backend que le publica las alertas. Encendidos por
# defecto: el servicio es el unico que los atiende. En false solo para volver atras a un backend que
# aun tenga su modulo de notificaciones (ver "Servicio de notificaciones" en el README).
# SECURITY_EVENTS_CONSUMER_ENABLED=true
# ALERT_EVENTS_CONSUMER_ENABLED=true
# ALERT_OUTBOX_RELAY_ENABLED=true

# ── Broker MQTT ─────────────────────────────────────────────────────────────────
# IP de LAN de este PC (hostname -I), nunca localhost: es lo que el servicio de dispositivos
# entrega a la web para escribirla al modulo.
DEVICE_MQTT_PUBLIC_HOST=
DEVICE_MQTT_PUBLIC_PORT=8883
# Credenciales del servicio de mediciones en el broker (solo lee la telemetria, y guarda las
# lecturas). Cualquier valor aleatorio: openssl rand -hex 24. Las comprueba el servicio de
# dispositivos. El backend ya no se conecta al broker: MQTT_BACKEND_USER/PASS sobran.
MQTT_MEASUREMENT_SERVICE_USER=em-measurement-service
MQTT_MEASUREMENT_SERVICE_PASS=
# Credenciales del servicio de dispositivos en el broker (conectividad y comandos). Otro valor
# aleatorio: openssl rand -hex 24
MQTT_DEVICE_SERVICE_USER=em-device-service
MQTT_DEVICE_SERVICE_PASS=

# ── Correo (alertas, recuperacion, verificacion) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EnergyMonitor <support.yourapp@gmail.com>

# ── Google (inicio de sesion con Google) ─────────────────────────────────────────
# OAuth client tipo "Web application" de Google Cloud Console. En "Authorized JavaScript
# origins" debe estar el origen desde el que se sirve la web (aqui http://localhost).
# El secreto solo lo usa el servicio de seguridad; nunca llega al navegador. Vacio = boton oculto/503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Notificaciones ───────────────────────────────────────────────────────────────
NOTIFICATION_WEB_URL=http://localhost
# Web Push (VAPID). Vacio = push desactivado; el correo sigue funcionando.
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
# Push a las apps moviles (relay de Expo): token de expo.dev → Access tokens. Solo del servidor,
# nunca en el .env de la app movil. Vacio = push movil desactivado; correo y web push siguen.
EXPO_ACCESS_TOKEN=

# ── Frontend ─────────────────────────────────────────────────────────────────────
# Mismo cliente OAuth que GOOGLE_CLIENT_ID del servicio de seguridad. Vacio = boton de Google oculto.
VITE_GOOGLE_CLIENT_ID=

# ── Codigo fuente (opcional) ─────────────────────────────────────────────────────
# Rutas de los repositorios, relativas a esta carpeta, si no estan clonados al lado.
# BACKEND_CONTEXT=../backend/energy-monitor-backend
# SECURITY_CONTEXT=../backend/en-monitor-security-service
# DEVICE_CONTEXT=../backend/en-monitor-device-service
# MEASUREMENT_CONTEXT=../backend/en-monitor-measurement-service
# HOME_CONTEXT=../backend/en-monitor-home-service
# NOTIFICATION_CONTEXT=../backend/en-monitor-notification-service
# GATEWAY_CONTEXT=../backend/en-monitor-api-gateway
# FRONTEND_CONTEXT=../frontend/energy-monitor-web
