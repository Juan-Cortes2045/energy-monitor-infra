# Copia este archivo como .env (ignorado por git) y rellena cada valor.
# Lo usa: docker compose up -d --build

# ── Base de datos ───────────────────────────────────────────────────────────────
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Seguridad del backend ───────────────────────────────────────────────────────
# openssl rand -hex 32
SECURITY_RESET_PEPPER=
# Origen publico de la web; con nginx de mismo origen basta http://localhost
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost
# Dueño de ./keys (el backend corre como 10001 en la imagen). Si las claves las genera
# prepare.sh con tu usuario, pon aqui tu uid/gid con:  id -u  /  id -g
BACKEND_UID=10001
BACKEND_GID=10001

# ── Broker MQTT ─────────────────────────────────────────────────────────────────
# IP de LAN de este PC (hostname -I), nunca localhost: es lo que la web escribe al modulo.
DEVICE_MQTT_PUBLIC_HOST=
DEVICE_MQTT_PUBLIC_PORT=8883
# Credenciales del backend en el broker. Cualquier valor aleatorio: openssl rand -hex 24
MQTT_BACKEND_USER=em-backend
MQTT_BACKEND_PASS=

# ── Correo (alertas, recuperacion, verificacion) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EnergyMonitor <support.yourapp@gmail.com>

# ── Google (inicio de sesion con Google) ─────────────────────────────────────────
# OAuth client tipo "Web application" de Google Cloud Console. En "Authorized JavaScript
# origins" debe estar el origen desde el que se sirve la web (aqui http://localhost).
# El secreto solo lo usa el backend; nunca llega al navegador. Vacio = boton oculto/503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Notificaciones ───────────────────────────────────────────────────────────────
NOTIFICATION_WEB_URL=http://localhost
# Web Push (VAPID). Vacio = push desactivado; el correo sigue funcionando.
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────────
# Mismo cliente OAuth que GOOGLE_CLIENT_ID del backend. Vacio = boton de Google oculto.
VITE_GOOGLE_CLIENT_ID=
