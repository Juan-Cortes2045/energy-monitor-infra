# Copia este archivo como .env.prod en el servidor (ignorado por git) y rellena cada valor.
# Lo usa: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Codigo fuente ───────────────────────────────────────────────────────────────
# Clones de los repositorios, relativos a esta carpeta.
BACKEND_CONTEXT=../backend/energy-monitor-backend
SECURITY_CONTEXT=../backend/en-monitor-security-service
DEVICE_CONTEXT=../backend/en-monitor-device-service
MEASUREMENT_CONTEXT=../backend/en-monitor-measurement-service
GATEWAY_CONTEXT=../backend/en-monitor-api-gateway
FRONTEND_CONTEXT=../frontend/energy-monitor-web

# ── Base de datos ───────────────────────────────────────────────────────────────
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Seguridad (servicio de seguridad y API gateway) ─────────────────────────────
# Pepper de los codigos de recuperacion: openssl rand -hex 32. Si ya habia uno, el mismo valor:
# con otro, los codigos ya enviados dejan de servir.
SECURITY_RESET_PEPPER=
# Origen publico de la web, p. ej. https://app.example.com (CORS, lo responde el gateway)
SECURITY_CORS_ALLOWED_ORIGINS=
# Carpeta con private.pem y public.pem (par RSA de los JWT). El servicio de seguridad recibe
# las dos; el backend, los servicios de dispositivos y mediciones y el gateway solo public.pem.
JWT_KEYS_DIR=/opt/energy-monitor/keys
# Usuario con el que corre el servicio de seguridad; debe poder leer private.pem. La imagen usa 10001:
# pon aqui el uid/gid dueño de JWT_KEYS_DIR, o ejecuta
#   sudo chown -R 10001:10001 /opt/energy-monitor/keys
BACKEND_UID=10001
BACKEND_GID=10001

# ── Comunicacion entre servicios ────────────────────────────────────────────────
# RabbitMQ (eventos de cuenta y pedidos de correo). Cualquier valor aleatorio: openssl rand -hex 24
# El usuario se crea al iniciar el volumen por primera vez: cambiarlo despues exige hacerlo
# tambien dentro de RabbitMQ (rabbitmqctl change_password).
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=
# Token de las llamadas /internal entre los servicios (seguridad, dispositivos, mediciones y backend): openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Broker MQTT ─────────────────────────────────────────────────────────────────
# Carpeta con server.crt (fullchain de Let's Encrypt) y server.key (privkey) del dominio del broker
MQTT_CERT_DIR=/opt/energy-monitor/mqtt-certs
# Dominio publico del broker, que se entrega a cada dispositivo al vincularlo, p. ej. mqtt.example.com
DEVICE_MQTT_PUBLIC_HOST=
DEVICE_MQTT_PUBLIC_PORT=8883
# Credenciales del servicio de mediciones en el broker (solo lee la telemetria, y guarda las
# lecturas). Cualquier valor aleatorio: openssl rand -hex 24. Las comprueba el servicio de
# dispositivos. El backend ya no se conecta al broker: MQTT_BACKEND_USER/PASS sobran.
MQTT_MEASUREMENT_SERVICE_USER=em-measurement-service
MQTT_MEASUREMENT_SERVICE_PASS=
# Credenciales del servicio de dispositivos en el broker (conectividad y comandos). Otro valor
# aleatorio: openssl rand -hex 24
MQTT_DEVICE_SERVICE_USER=em-device-service
MQTT_DEVICE_SERVICE_PASS=

# ── Correo (alertas, recuperacion, verificacion) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Google (inicio de sesion con Google) ─────────────────────────────────────────
# En "Authorized JavaScript origins" del cliente OAuth debe estar el origen publico de la web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# ── Notificaciones ───────────────────────────────────────────────────────────────
# URL publica de la web, usada en los enlaces de los correos de alerta
NOTIFICATION_WEB_URL=
# Web Push (VAPID). Vacio = push desactivado; el correo sigue funcionando. Comandos en el README.
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
# Push a las apps moviles (relay de Expo): token de expo.dev → Access tokens. Solo del servidor,
# nunca en el .env de la app movil. Vacio = push movil desactivado; correo y web push siguen.
EXPO_ACCESS_TOKEN=

# ── Frontend ─────────────────────────────────────────────────────────────────────
# Puerto local (127.0.0.1) al que apunta el proxy HTTPS
WEB_PORT=8081
